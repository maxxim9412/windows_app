{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "bible-reflection",
          "appId": "1:96467453228:android:f9e39320e2bef3e2591889",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "bible-reflection",
          "configurations": {
            "android": "1:96467453228:android:f9e39320e2bef3e2591889",
            "web": "1:96467453228:web:70cdf51cda13cfc7591889"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "comment": "Firebase по умолчанию кэширует всё на час, включая index.html и flutter_service_worker.js — а ими PWA обновляет себя. Из-за этого новая сборка не доезжала до телефона, пока вручную не очистишь данные сайта. no-cache не запрещает кэш, а требует сверяться с сервером: не изменилось — придёт 304, и файл возьмётся из кэша.",
        "source": "**/*.@(html|js|json|apk)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
