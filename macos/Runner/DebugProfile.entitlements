<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Без песочницы (см. Release.entitlements) — она ломала Firebase Auth
	(Keychain в песочнице требует Keychain Sharing с настоящей команды
	разработчика). cs.allow-jit остаётся: нужен Dart VM в debug-сборке
	независимо от песочницы. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
