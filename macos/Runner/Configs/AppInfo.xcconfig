// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. Это ещё и имя исполняемого файла и папки .app —
// кириллица с пробелами в этой роли ломает codesign ("code object is not
// signed at all" на Contents/MacOS/<имя>). Красивое имя — через
// CFBundleDisplayName в Info.plist, оно не обязано совпадать с этим.
PRODUCT_NAME = bible_reflection

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = app.qt.reflection

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026. All rights reserved.
