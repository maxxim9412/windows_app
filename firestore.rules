rules_version = '2';

// Правила доступа к Firestore. Публикуются из этого файла командой:
//   firebase deploy --only firestore:rules
// (правка в консоли Firebase будет затёрта следующим деплоем — меняйте здесь).
service cloud.firestore {
  match /databases/{database}/documents {

    // Супер-админ — пользователь с полем isAdmin: true в профиле.
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Поле не должно "откатиться" из заполненного в пустое: если оно и раньше
    // было пустым/отсутствовало — не мешаем дозаполнять остальное отдельным
    // сохранением (церковь и телефон в профиле правятся порознь), но если
    // было заполнено — новое значение обязано остаться непустой строкой.
    function keptOrFilled(oldVal, newVal) {
      return !(oldVal is string) || oldVal.size() == 0
        || (newVal is string && newVal.size() > 0);
    }

    // Церкви — справочник для выбора при регистрации. Читать может КТО УГОДНО,
    // в том числе без входа: список нужен на экране регистрации, а там человек
    // ещё не авторизован. Раньше стояло `request.auth != null` — из-за этого
    // выпадашка церквей была пуста и регистрация не проходила. В документе лишь
    // название, список админов и оформление — ничего секретного.
    // Создаёт/удаляет — супер-админ.
    match /churches/{churchId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();

      // Правит церковь супер-админ. Её собственный админ — только оформление
      // (`themeColor`, и старое `theme`), и ничего больше: иначе он смог бы
      // дописать себя или чужого в adminUids и захватить церковь, либо
      // переименовать её. hasOnly проверяет ИЗМЕНЁННЫЕ ключи, поэтому подмена
      // adminUids в том же запросе правило не пройдёт.
      allow update: if isSuperAdmin()
        || (request.auth != null
            && request.auth.uid in resource.data.adminUids
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['themeColor', 'theme']));

      // График церкви: отрывки QT и чтение. Читают все, пишут админ церкви
      // (uid в adminUids) или супер-админ.
      function isChurchAdmin() {
        return request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/churches/$(churchId)).data.adminUids;
      }
      match /passages/{date} {
        allow read: if request.auth != null;
        allow write: if isSuperAdmin() || isChurchAdmin();
      }
      match /readings/{date} {
        allow read: if request.auth != null;
        allow write: if isSuperAdmin() || isChurchAdmin();
      }

      // Разрешение на несколько троек: {limit: N} на прихожанина. Ставит админ
      // церкви (или супер-админ), сам человек может лишь прочитать своё —
      // поэтому это отдельный документ, а не поле профиля: профиль человек
      // пишет сам и мог бы поднять лимит себе.
      match /triadAllowances/{memberUid} {
        allow get: if request.auth != null
          && (request.auth.uid == memberUid || isSuperAdmin() || isChurchAdmin());
        allow list: if isSuperAdmin() || isChurchAdmin();
        allow write: if isSuperAdmin() || isChurchAdmin();
      }
    }

    // Профиль пользователя: email, имя, церковь, отметки чтения (readingDone).
    //
    // Читают: сам владелец, супер-админ (ему нужно найти человека по email,
    // чтобы назначить админом церкви, — см. ChurchRepository.userByEmail), и
    // админ ЕГО церкви (нужно для отчёта по церкви — кто без телефона/тройки).
    // Раньше читал любой авторизованный: это отдавало email всех пользователей
    // и историю чтения любому, кто спросит, — в приложении не видно, но сервер
    // отдавал.
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || isSuperAdmin()
            || (resource.data.get('churchId', null) != null
                && request.auth.uid in
                   get(/databases/$(database)/documents/churches/$(resource.data.churchId)).data.adminUids));

      // Церковь и телефон обязательны с регистрации и не могут быть стёрты
      // обратно в пустоту — иначе человек выпадает из всех отчётов по
      // церкви и не виден админу. keptOrFilled() всё же разрешает заполнить
      // их не разом, а по одному полю за раз (так делает всплывающее окно
      // «Заполните профиль»).
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.churchId is string
        && request.resource.data.churchId.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && keptOrFilled(resource.data.get('churchId', null),
                         request.resource.data.get('churchId', null))
        && keptOrFilled(resource.data.get('phone', null),
                         request.resource.data.get('phone', null));
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Заметки: писать может только владелец; читать — владелец и участники
      // его троек. Основной механизм — список visibleTo в самой заметке
      // (объединение участников всех троек автора: человек может быть в
      // нескольких). Клауза с triadId оставлена для заметок старого формата,
      // где visibleTo ещё нет.
      match /notes/{noteId} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid in resource.data.get('visibleTo', []) ||
          (resource.data.triadId != null &&
           request.auth.uid in
             get(/databases/$(database)/documents/triads/$(resource.data.triadId)).data.memberUids)
        );
      }
    }

    // Индекс «код приглашения → id тройки». Личных данных не содержит, поэтому
    // читать его безопасно. Существует ради того, чтобы вступление по коду не
    // требовало листать тройки: правила не умеют ограничивать запрос по
    // фильтру, так что разрешить поиск `where('inviteCode', ...)` означало бы
    // разрешить выгрузить все тройки — с именами и почтами участников.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false; // перебирать коды незачем
      allow create, delete: if request.auth != null;
      allow update: if false; // код нельзя перенаправить на чужую тройку
    }

    // Тройки. В документе лежат имена и почты участников, поэтому список
    // закрыт: раньше `allow read` разрешал любому вошедшему выгрузить их все.
    match /triads/{triadId} {
      // По id — можно всем вошедшим: это нужно вступающему по коду и тому, кто
      // ждёт одобрения заявки. Id случайный, перебрать его нельзя.
      allow get: if request.auth != null;

      // Списком — только своё: свои тройки, админу церкви — тройки его церкви
      // (для отчёта), супер-админу — все.
      //
      // Порядок условий важен: на запрос отводится всего 10 обращений к другим
      // документам. Участник проходит без единого. Админ церкви — за одно, и
      // это всегда один и тот же документ церкви (отчёт фильтрует по churchId),
      // так что обращение кэшируется. isSuperAdmin() стоит последним: он самый
      // дорогой, а супер-админ — один человек.
      allow list: if request.auth != null && (
        request.auth.uid in resource.data.memberUids
        || ('churchId' in resource.data
            && request.auth.uid in
               get(/databases/$(database)/documents/churches/$(resource.data.churchId)).data.adminUids)
        || isSuperAdmin()
      );

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if request.auth != null;

      // Совместная встреча: какая заметка показывается всем сейчас.
      match /shared/{doc} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
