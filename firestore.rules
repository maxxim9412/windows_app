rules_version = '2';

// Правила доступа к Firestore. Вставьте их в консоли Firebase:
// Firestore Database → Rules → заменить → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Супер-админ — пользователь с полем isAdmin: true в профиле.
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Церкви. Читают все вошедшие (нужно для выбора при регистрации).
    // Создаёт/удаляет/меняет админов — супер-админ.
    match /churches/{churchId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSuperAdmin();

      // График церкви: отрывки QT и чтение. Читают все, пишут админ церкви
      // (uid в adminUids) или супер-админ.
      function isChurchAdmin() {
        return request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/churches/$(churchId)).data.adminUids;
      }
      match /passages/{date} {
        allow read: if request.auth != null;
        allow write: if isSuperAdmin() || isChurchAdmin();
      }
      match /readings/{date} {
        allow read: if request.auth != null;
        allow write: if isSuperAdmin() || isChurchAdmin();
      }
    }

    // Профиль пользователя.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Заметки: писать может только владелец; читать — владелец и участники
      // его тройки (по полю triadId в заметке).
      match /notes/{noteId} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          (resource.data.triadId != null &&
           request.auth.uid in
             get(/databases/$(database)/documents/triads/$(resource.data.triadId)).data.memberUids)
        );
      }
    }

    // Тройки. Читать может любой авторизованный (нужно для поиска по коду).
    // Изменения (вступление/согласия/удаление) проверяются логикой приложения.
    match /triads/{triadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if request.auth != null;

      // Совместная встреча: какая заметка показывается всем сейчас.
      match /shared/{doc} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
