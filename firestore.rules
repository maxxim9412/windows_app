rules_version = '2';

// Правила доступа к Firestore. Вставьте их в консоли Firebase:
// Firestore Database → Rules → заменить → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Профиль пользователя: читать могут все авторизованные (нужно для поиска
    // участников тройки), писать — только владелец.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Остальное пока запрещено (тройки и заметки добавим следующим шагом).
  }
}
